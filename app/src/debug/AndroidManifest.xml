<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- debug ビルドのみ。adb shell（DUMP 権限を持つ）からジオフェンス進入を模擬する -->
        <receiver
            android:name=".DebugTriggerReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mujicheckin.DEBUG_ENTER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
